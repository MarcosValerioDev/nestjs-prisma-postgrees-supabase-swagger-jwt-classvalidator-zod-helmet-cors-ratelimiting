# Supabase PostgreSQL (pooled connection for the app, direct connection for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
PORT=3000
CORS_ORIGINS="http://localhost:3000"
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
